programa {
  funcao inicio() 
  
  {
    inteiro n1, n2, n3
    leia(n1, n2, n3)
    
    se (n1>n2 & n1>n3){
      escreva ("O número 1 é o maior")

    }senao{

      n2>n3

    }

    se (n2 & n2> n3){
       escreva ("O número 2 é o maior")

    }senao{

      n3>n1 & n3>n2
      escreva ("O núemro 3 é o maior")

    }


  }

  }
}
